{
  "name": "date-fns-broadcast",
  "version": "1.3.0",
  "description": "date-fns plugin for broadcast calendar week, month, quarter, and year calculations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "date-fns": ">=4.0.0"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "format": "esm",
    "dts": true,
    "external": [
      "date-fns"
    ]
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brightloudnoise/date-fns-broadcast.git"
  },
  "homepage": "https://github.com/brightloudnoise/date-fns-broadcast#readme",
  "bugs": {
    "url": "https://github.com/brightloudnoise/date-fns-broadcast/issues"
  },
  "keywords": [
    "date-fns",
    "broadcast",
    "calendar",
    "broadcast-calendar",
    "media",
    "television",
    "date"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Geoff Holden <geoff@brightloudnoise.com>",
  "license": "MIT",
  "devDependencies": {
    "@date-fns/tz": "^1.5.0",
    "@eslint/js": "^9.39.5",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
